# Maintainer: hakergeniusz <hakergeniusz@users.noreply.github.com>
# Clean-room Rust GTK4 emoji picker — see SPEC.md in the source tree.

pkgname=emoxidize
pkgver=1.0.0beta.1
pkgrel=1
pkgdesc="Single-instance GTK4/libadwaita emoji picker (clean-room Rust implementation)"
arch=(x86_64 aarch64)
url="https://github.com/hakergeniusz/emoxidize"
license=(MIT)
depends=(gtk4 libadwaita dconf)
makedepends=(cargo clang)
provides=(emoji-picker)
source=("$pkgname::https://github.com/hakergeniusz/emoxidize/archive/refs/tags/v1.0.0-beta.1.tar.gz")
sha256sums=('SKIP')  # replace with the release tarball checksum
options=(!lto)      # LTO is configured per-profile in Cargo.toml

prepare() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --frozen --release
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 target/release/emoxidize -t "$pkgdir/usr/bin/"
    install -Dm644 data/io.github.hakergeniusz.Emoxidize.desktop \
        "$pkgdir/usr/share/applications/io.github.hakergeniusz.Emoxidize.desktop"
    install -Dm644 data/io.github.hakergeniusz.Emoxidize.metainfo.xml \
        "$pkgdir/usr/share/metainfo/io.github.hakergeniusz.Emoxidize.metainfo.xml"
    install -Dm644 data/io.github.hakergeniusz.Emoxidize.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Emoxidize.svg"
    install -Dm644 data/io.github.hakergeniusz.Emoxidize-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.hakergeniusz.Emoxidize-symbolic.svg"
    for size in 16 24 32 48 64 128 256; do
        install -Dm644 "data/icons/hicolor/${size}x${size}/apps/io.github.hakergeniusz.Emoxidize.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.hakergeniusz.Emoxidize.png"
    done
    install -Dm644 data/io.github.hakergeniusz.Emoxidize.gschema.xml \
        "$pkgdir/usr/share/glib-2.0/schemas/io.github.hakergeniusz.Emoxidize.gschema.xml"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    # GNOME Shell paste bridge (optional component)
    install -d "$pkgdir/usr/share/gnome-shell/extensions/emoxidize@hakergeniusz"
    install -Dm644 extension/emoxidize@hakergeniusz/{metadata.json,extension.js} \
        -t "$pkgdir/usr/share/gnome-shell/extensions/emoxidize@hakergeniusz/"
}
