{
  "id": "io.github.hakergeniusz.Emoxidize",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "emoxidize",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=io.github.hakergeniusz.Emoxidize"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/emoxidize/cargo",
      "RUST_BACKTRACE": "1"
    }
  },
  "modules": [
    {
      "name": "emoxidize",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --version",
        "cargo build --offline --release",
        "install -Dm755 target/release/emoxidize -t /app/bin/",
        "install -Dm644 data/io.github.hakergeniusz.Emoxidize.desktop -t /app/share/applications/",
        "install -Dm644 data/io.github.hakergeniusz.Emoxidize.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/io.github.hakergeniusz.Emoxidize.svg /app/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Emoxidize.svg",
        "install -Dm644 data/io.github.hakergeniusz.Emoxidize-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.hakergeniusz.Emoxidize-symbolic.svg",
        "for size in 16 24 32 48 64 128 256; do install -Dm644 data/icons/hicolor/${size}x${size}/apps/io.github.hakergeniusz.Emoxidize.png /app/share/icons/hicolor/${size}x${size}/apps/io.github.hakergeniusz.Emoxidize.png; done",
        "install -Dm644 data/io.github.hakergeniusz.Emoxidize.gschema.xml /app/share/glib-2.0/schemas/io.github.hakergeniusz.Emoxidize.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "mkdir -p /app/share/dbus-1/services",
        "printf '[D-BUS Service]\\nName=io.github.hakergeniusz.Emoxidize\\nExec=/app/bin/emoxidize --gapplication-service\\n' > /app/share/dbus-1/services/io.github.hakergeniusz.Emoxidize.service"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/hakergeniusz/emoxidize.git",
          "tag": "v1.0.0-beta.1",
          "commit": "d27f82f58db310371a01d9e967283690d6f782b7"
        },
        "generated-cargo-sources.json"
      ]
    }
  ]
}